# === Banco de Dados (Supabase) ===
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# === Provedor de LLM ===
# "ollama" = modelo local (llama3.1) | "anthropic" = Claude via API
# "litellm" = proxy compatível com OpenAI (roteia para claude/gemini/gpt)
LLM_PROVIDER=ollama

# === LLM local via Ollama ===
# Rode antes: `ollama pull llama3.1` (Ollama servindo em localhost:11434)
OLLAMA_MODEL=llama3.1
OLLAMA_BASE_URL=http://localhost:11434

# === API LLM (Anthropic Claude) — usado só quando LLM_PROVIDER=anthropic ===
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_MAX_TOKENS=2048

# === Proxy LiteLLM — usado só quando LLM_PROVIDER=litellm ===
# API compatível com OpenAI. LITELLM_MODEL deve ser um dos modelos expostos
# pelo proxy (ex: claude-sonnet-4, claude-haiku-3-5, gemini-2.5-flash, gpt-4o-mini).
LITELLM_API_KEY=sk-...
LITELLM_BASE_URL=http://localhost:4000
LITELLM_MODEL=gpt-4o-mini

# === API Portal da Transparência (CGU) ===
CGU_API_KEY=sua-chave-api-aqui
CGU_API_BASE_URL=https://api.portaldatransparencia.gov.br/api-de-dados
CGU_RATE_LIMIT_RPM=400

# === Embeddings ===
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIMENSIONS=384
EMBEDDING_BATCH_SIZE=256

# === HNSW Index ===
HNSW_M=16
HNSW_EF_CONSTRUCTION=200

# === Busca ===
SIMILARITY_THRESHOLD=0.45
MAX_RESULTS=20

# === Aplicação ===
APP_HOST=0.0.0.0
APP_PORT=8000
FRONTEND_URL=http://localhost:5173
LOG_LEVEL=INFO

# === Sync para Produção (sync_to_production.py) ===
PG_HOST=aws-0-sa-east-1.pooler.supabase.com
PG_PORT=5432
PG_DBNAME=postgres
PG_USER=postgres.your-project-ref
PG_PASSWORD=sua-senha-aqui
PG_SSLMODE=require
